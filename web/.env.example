# Public site URL, used to build the Dodo return_url and OG metadata.
NEXT_PUBLIC_SITE_URL="https://claudetones.dev"

# Price shown on the landing page (display only; the real price lives in Dodo).
NEXT_PUBLIC_PRO_PRICE="$12"

# ---- License storage -------------------------------------------------------
# Set both in production. Without them the app falls back to a local JSON file
# at web/.data/licenses.json (development only — a serverless FS is ephemeral).
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Devices allowed per key (default 2).
CLAUDETONES_MAX_DEVICES="2"

# ---- Dodo Payments ---------------------------------------------------------
DODO_PAYMENTS_API_KEY=""
DODO_PRODUCT_ID=""            # the Pro Pack product id (pdt_...)
DODO_ENVIRONMENT="test_mode"  # 'test_mode' | 'live_mode'
DODO_PAYMENTS_WEBHOOK_KEY=""  # webhook signing secret (Standard Webhooks)

# Optional: static payment link fallback when the API key isn't set.
NEXT_PUBLIC_DODO_PAYMENT_LINK=""

# ---- Optional: email the key to buyers (Resend) ----------------------------
RESEND_API_KEY=""
EMAIL_FROM="claudetones <license@yourdomain.com>"
